# Local default. In a container use HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3187
DB_PATH=data/tdlend.sqlite
# Set to 1 only behind correctly configured HTTPS.
COOKIE_SECURE=0
# Optional. Leave blank to let initialization generate local-only passwords.
# ADMIN_PASSWORD=
# CLIENT_PASSWORD=
# DEMO_CREDENTIALS_PATH=data/demo-access.json
